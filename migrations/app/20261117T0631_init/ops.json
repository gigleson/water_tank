  {
    "id": "table.Delivery",
    "label": "Create table \"Delivery\"",
    "summary": "Creates table \"Delivery\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Delivery"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Delivery\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Delivery\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "table \"Delivery\""
        }
      }
    ],
    "execute": [
      {
        "description": "create table \"Delivery\"",
        "sql": "CREATE TABLE \"public\".\"Delivery\" (\n  \"address\" text NOT NULL,\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"customerName\" text NOT NULL,\n  \"deliveryDate\" timestamptz(3) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"phone\" text NOT NULL,\n  \"quantity\" int4 NOT NULL,\n  \"status\" text DEFAULT 'Pending' NOT NULL,\n  \"tankSize\" int4 NOT NULL,\n  \"updatedAt\" timestamptz(3) NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Delivery\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"Delivery\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"Delivery\""
        }
      }
    ]
  }
