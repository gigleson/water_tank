
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Delivery</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="container">
        <h1>Book Water Tank Delivery</h1>

        <form action="/deliveries" method="POST">

            <label>Customer Name</label>
            <input type="text" name="customerName" required>

            <label>Address</label>
            <input type="text" name="address" required>

            <label>Phone Number</label>
            <input type="tel" name="phone" required>

            <label>Tank Size (Litres)</label>
            <select name="tankSize" required>
                <option value="500">500 Litres</option>
                <option value="1000">1000 Litres</option>
                <option value="2000">2000 Litres</option>
            </select>

            <label>Quantity</label>
            <input type="number" name="quantity" min="1" required>

            <label>Delivery Date</label>
            <input type="date" name="deliveryDate" required>

            <button type="submit">Submit Delivery</button>
        </form>

        <a href="/deliveries">Back to Deliveries</a>
    </main>
</body>
</html>
